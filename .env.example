OPENAI_API_KEY=
COMPOSIO_API_KEY=
# A stable identifier for this person in your app; it does not need to be an email.
COMPOSIO_USER_ID=personal-user
# Pin the Google Drive action schema used by the document importer.
COMPOSIO_GOOGLEDRIVE_VERSION=20260721_00
# Optional path-delimited allowlist for server-side filePath imports. Defaults to ./workspace and ./uploads.
DOCUMENT_UPLOAD_DIRS=
