OPENAI_API_KEY=
# Mastra-managed Neon provides DATABASE_URL in the deployment environment.
# Leave empty for local SQLite storage, or configure Turso below.
DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
COMPOSIO_API_KEY=
# A stable identifier for this person in your app; it does not need to be an email.
COMPOSIO_USER_ID=personal-user
# Pin the action schemas used by Mentor discovery and deterministic acquisition.
COMPOSIO_TOOLKIT_VERSION_GOOGLEDOCS=20260721_00
COMPOSIO_TOOLKIT_VERSION_LINEAR=20260804_00
COMPOSIO_TOOLKIT_VERSION_TRELLO=20260812_00
# Pin the Google Drive action schema used by the document importer.
COMPOSIO_GOOGLEDRIVE_VERSION=20260721_00
# Required for the Mentor knowledge base. API key is optional for an unauthenticated local node.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=mentor-resources
ELASTICSEARCH_API_KEY=
# Optional path-delimited allowlist for server-side filePath imports. Defaults to ./workspace and ./uploads.
DOCUMENT_UPLOAD_DIRS=
